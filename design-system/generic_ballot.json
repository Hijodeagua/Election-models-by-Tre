<!-- @dsCard group="Colors" viewport="700x400" name="Semantic Color Palette" -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Election Oracle Colors</title>
  <link rel="stylesheet" href="../styles.css">
  <style>
    body {
      font-family: var(--font-sans);
      padding: var(--space-6);
      background: white;
      margin: 0;
    }
    .color-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: var(--space-4);
    }
    .color-swatch {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .swatch-box {
      width: 100%;
      height: 80px;
      border-radius: var(--radius-md);
      border: 1px solid var(--color-border-light);
      box-shadow: var(--shadow-sm);
    }
    .swatch-label {
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-semibold);
      color: var(--color-text-primary);
      line-height: var(--line-height-tight);
    }
    .swatch-hex {
      font-size: var(--font-size-xs);
      color: var(--color-text-tertiary);
      font-family: var(--font-mono);
    }
  </style>
</head>
<body>
  <div class="color-grid">
    <div class="color-swatch">
      <div class="swatch-box" style="background: var(--color-dem);"></div>
      <div class="swatch-label">Democrat Blue</div>
      <div class="swatch-hex">#2563eb</div>
    </div>
    <div class="color-swatch">
      <div class="swatch-box" style="background: var(--color-rep);"></div>
      <div class="swatch-label">Republican Red</div>
      <div class="swatch-hex">#dc2626</div>
    </div>
    <div class="color-swatch">
      <div class="swatch-box" style="background: var(--color-slate-50); border: 2px solid var(--color-border-default);"></div>
      <div class="swatch-label">Background Light</div>
      <div class="swatch-hex">#f8fafc</div>
    </div>
    <div class="color-swatch">
      <div class="swatch-box" style="background: var(--color-slate-200);"></div>
      <div class="swatch-label">Border Default</div>
      <div class="swatch-hex">#e2e8f0</div>
    </div>
    <div class="color-swatch">
      <div class="swatch-box" style="background: var(--color-slate-600);"></div>
      <div class="swatch-label">Text Secondary</div>
      <div class="swatch-hex">#475569</div>
    </div>
    <div class="color-swatch">
      <div class="swatch-box" style="background: var(--color-slate-900);"></div>
      <div class="swatch-label">Text Primary</div>
      <div class="swatch-hex">#0f172a</div>
    </div>
  </div>
</body>
</html>
