<body>
<div id="root"></div>
<script type="text/babel">
const { DesignCanvas, DCSection, DCArtboard } = window;

// ─── Shared SVG chart (reused across all designs) ───────────────────────────
function TrendChart({ demColor, repColor, bandColor, bgColor = "transparent", gridColor = "#e2e8f0", textColor = "#94a3b8" }) {
  // Approval data approximation: ~45% → ~40%, disapprove ~48% → ~52%
  // ViewBox: 0 0 560 160, Y: 30%=160, 70%=0, so y = (70 - val) / 40 * 160
  const y = v => ((70 - v) / 40) * 160;
  const approvePoints = [
    [0, y(45.8)], [40, y(45.2)], [80, y(44.1)], [120, y(43.4)],
    [160, y(42.8)], [200, y(41.9)], [240, y(41.1)], [280, y(40.5)],
    [320, y(40.8)], [360, y(41.3)], [400, y(40.9)], [440, y(40.4)],
    [480, y(40.2)], [520, y(40.6)], [560, y(40.3)]
  ];
  const disapprovePoints = [
    [0, y(47.9)], [40, y(48.4)], [80, y(49.1)], [120, y(49.8)],
    [160, y(50.2)], [200, y(50.9)], [240, y(51.4)], [280, y(51.8)],
    [320, y(51.5)], [360, y(51.1)], [400, y(51.6)], [440, y(52.0)],
    [480, y(52.3)], [520, y(51.9)], [560, y(52.1)]
  ];
  const toPath = pts => pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${p[0]},${p[1]}`).join(' ');
  const bandTop = approvePoints.map(([x, y]) => [x, y - 7]);
  const bandBot = approvePoints.map(([x, y]) => [x, y + 7]).reverse();
  const bandPath = [...bandTop.map(([x,y], i) => `${i===0?'M':'L'}${x},${y}`), ...bandBot.map(([x,y]) => `L${x},${y}`), 'Z'].join(' ');
  const gridLines = [35, 40, 45, 50, 55];

  return (
    <svg viewBox="0 0 580 165" style={{ width: '100%', height: '100%' }}>
      {/* Grid lines */}
      {gridLines.map(v => (
        <g key={v}>
          <line x1="28" y1={y(v)} x2="560" y2={y(v)} stroke={gridColor} strokeWidth="1" strokeDasharray="4,3" opacity="0.5" />
          <text x="24" y={y(v) + 4} textAnchor="end" fontSize="9" fill={textColor}>{v}%</text>
        </g>
      ))}
      {/* CI band */}
      <path d={bandPath} fill={bandColor} />
      {/* Lines */}
      <path d={toPath(disapprovePoints)} fill="none" stroke={repColor} strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" />
      <path d={toPath(approvePoints)} fill="none" stroke={demColor} strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" />
      {/* Latest dots */}
      <circle cx="560" cy={y(40.3)} r="4" fill={demColor} />
      <circle cx="560" cy={y(52.1)} r="4" fill={repColor} />
      {/* Labels */}
      <text x="566" y={y(40.3) + 4} fontSize="9.5" fill={demColor} fontWeight="600">40.3</text>
      <text x="566" y={y(52.1) + 4} fontSize="9.5" fill={repColor} fontWeight="600">52.1</text>
      {/* X axis ticks */}
      {["Jan '25","Apr","Jul","Oct","Jan '26","Apr"].map((label, i) => (
        <text key={i} x={i * 110 + 28} y="162" fontSize="9" fill={textColor} textAnchor="middle">{label}</text>
      ))}
    </svg>
  );
}

