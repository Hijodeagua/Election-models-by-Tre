            <div style={{ fontSize: 11, fontWeight: 600, color: '#6b7280', textTransform: 'uppercase', letterSpacing: '0.08em' }}>Daily Trend · Approve vs Disapprove</div>
            <div style={{ display: 'flex', gap: 14 }}>
              <span style={{ fontSize: 10, color: '#3b82f6', display: 'flex', alignItems: 'center', gap: 5 }}>
                <span style={{ display: 'inline-block', width: 16, height: 2, background: '#3b82f6', borderRadius: 2 }}></span> Approve
              </span>
              <span style={{ fontSize: 10, color: '#ef4444', display: 'flex', alignItems: 'center', gap: 5 }}>
                <span style={{ display: 'inline-block', width: 16, height: 2, background: '#ef4444', borderRadius: 2 }}></span> Disapprove
              </span>
            </div>
          </div>
          <div style={{ height: 128 }}>
            <TrendChart demColor="#3b82f6" repColor="#ef4444" bandColor="rgba(59,130,246,0.08)" gridColor="#1f2937" textColor="#374151" />
          </div>
        </div>

        {/* Bottom */}
        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 8 }}>
          <div style={{ background: '#111827', border: '1px solid #1f2937', borderRadius: 8, padding: '10px 13px' }}>
            <div style={{ fontSize: 10, color: '#4b5563', textTransform: 'uppercase', letterSpacing: '0.1em', marginBottom: 7 }}>Generic Ballot</div>
            <div style={{ display: 'flex', gap: 14, alignItems: 'center' }}>
              <div><div style={{ fontFamily: "'IBM Plex Mono'", fontSize: 22, fontWeight: 500, color: '#3b82f6' }}>46.4%</div><div style={{ fontSize: 10, color: '#4b5563' }}>Democrat</div></div>
              <div><div style={{ fontFamily: "'IBM Plex Mono'", fontSize: 22, fontWeight: 500, color: '#ef4444' }}>41.1%</div><div style={{ fontSize: 10, color: '#4b5563' }}>Republican</div></div>
              <div style={{ marginLeft: 'auto', textAlign: 'right' }}>
                <div style={{ fontFamily: "'IBM Plex Mono'", fontSize: 22, fontWeight: 500, color: '#3b82f6' }}>D+5.3</div>
                <div style={{ fontSize: 10, color: '#4b5563' }}>344 polls</div>
              </div>
            </div>
          </div>
          <div style={{ background: '#111827', border: '1px solid #1f2937', borderRadius: 8, padding: '10px 13px' }}>
            <div style={{ fontSize: 10, color: '#4b5563', textTransform: 'uppercase', letterSpacing: '0.1em', marginBottom: 7 }}>Arizona Senate</div>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <div>
                <div style={{ fontSize: 12.5, color: '#9ca3af' }}>Gallego <span style={{ color: '#3b82f6', fontWeight: 600 }}>48.2%</span> · Lake <span style={{ color: '#ef4444', fontWeight: 600 }}>44.8%</span></div>
                <div style={{ display: 'flex', gap: 6, marginTop: 6 }}>
                  <span style={{ background: '#1e3a5f', color: '#60a5fa', border: '1px solid #1e40af', borderRadius: 4, padding: '2px 8px', fontSize: 10, fontWeight: 600 }}>NYT vibes on</span>
                  <span style={{ background: '#1f2937', color: '#6b7280', border: '1px solid #374151', borderRadius: 4, padding: '2px 8px', fontSize: 10 }}>Polymarket D 61%</span>
                </div>
              </div>
              <div style={{ fontFamily: "'IBM Plex Mono'", fontSize: 22, fontWeight: 500, color: '#3b82f6' }}>D+3.4</div>
            </div>
          </div>
        </div>
      </main>
    </div>
  );
}

