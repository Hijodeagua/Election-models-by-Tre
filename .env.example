# Election Oracle Configuration
# Copy to .env and fill in values

# VoteHub API (free, no key required currently)
VOTEHUB_BASE_URL=https://votehub.com/polls/api

# FiftyPlusOne (paid — leave blank to skip)
FIFTYPLUSONE_API_KEY=

# Congress.gov API
CONGRESS_GOV_API_KEY=

# New York Times API (free at https://developer.nytimes.com/)
NYT_API_KEY=

# Datawrapper API token (for publishing charts to Substack)
# Get one at https://app.datawrapper.de/account/api-tokens
DATAWRAPPER_API_TOKEN=

# Database
DATABASE_URL=sqlite:///data/election_oracle.db

# Data refresh interval (minutes)
REFRESH_INTERVAL_MINUTES=60

# Logging
LOG_LEVEL=INFO
