# Election Oracle Configuration
# Copy this file to .env and fill in values that apply to you.
# Everything works without any keys in --offline / --source csv mode.

# ── Data sources ──────────────────────────────────────────────────────────────

# VoteHub API (free, no key required)
VOTEHUB_BASE_URL=https://votehub.com/polls/api

# Silver Bulletin model CSV URLs (used by scripts/refresh_data.py --source silverb)
# If SB changes these, update here without touching code.
SILVERB_APPROVAL_CSV_URL=https://static.natesilver.net/approval.csv
SILVERB_GB_CSV_URL=https://static.natesilver.net/generic-ballot.csv

# FiftyPlusOne (paid — leave blank to skip)
FIFTYPLUSONE_API_KEY=

# Congress.gov API (free at https://api.congress.gov/sign-up/)
CONGRESS_GOV_API_KEY=

# FRED (free at https://fredaccount.stlouisfed.org/apikeys) — state economic panel.
# Optional: without a key scripts/download_economic_data.py uses FRED's keyless
# CSV export, which serves only the current (revised) vintage. A key unlocks
# ALFRED vintages, which a backtest needs to avoid look-ahead bias.
FRED_API_KEY=

# ── Publishing ─────────────────────────────────────────────────────────────────

# Datawrapper API token — get at https://app.datawrapper.de/account/api-tokens
DATAWRAPPER_API_TOKEN=

# Datawrapper chart IDs — copy from the chart URL: /chart/XXXXX/edit
# Create these charts in Datawrapper first, then paste their IDs here.
DW_CHART_APPROVAL_ID=
DW_CHART_APPROVAL_PRO_ID=
DW_CHART_GB_ID=
DW_CHART_SENATE_ID=
DW_CHART_HOUSE_EFFECTS_ID=

# ── Infrastructure ──────────────────────────────────────────────────────────────

DATABASE_URL=sqlite:///data/election_oracle.db
REFRESH_INTERVAL_MINUTES=60
LOG_LEVEL=INFO
